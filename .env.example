# External Client App consumer key. Keep the secret on the server only.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Exact public callback URL registered in the Salesforce app.
SF_CALLBACK_URL=http://localhost:3001/auth/callback
# Where OAuth should send the browser after the callback (Vite dev server).
APP_URL=http://localhost:5173
# login.salesforce.com for production orgs; test.salesforce.com for sandboxes.
SF_LOGIN_URL=https://login.salesforce.com
# Generate a long random value for deployed use.
SESSION_SECRET=replace-with-a-long-random-secret
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
PORT=3001
